#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <termios.h>

char getch(void) {
    struct termios oldt, newt;
    char ch;

    if (tcgetattr(STDIN_FILENO, &oldt) != 0) {
        return '\0';
    }

    newt = oldt;
    newt.c_lflag &= ~(ICANON | ECHO);

    if (tcsetattr(STDIN_FILENO, TCSANOW, &newt) != 0) {
        return '\0';
    }

    ch = getchar();

    if (tcsetattr(STDIN_FILENO, TCSANOW, &oldt) != 0) {
        return ch;
    }

    return ch;
}

